# Finance → Course Run Automations (n8n webhooks)
# -------------------------------------------------
# Production must define these on the host (they are NOT in the browser).
# Local: add to `.env`. Vercel: Project → Settings → Environment Variables (Production).
#
# Option A — one variable per workflow (recommended for clarity):
# -----------------------------------------------------------------

N8N_WEBHOOK_UPDATE_GRANT_STATUS_TOTAL=
N8N_WEBHOOK_UPDATE_ASSESSMENT=
N8N_WEBHOOK_CREATE_ENROLMENTS_ERROR_STATUS=
N8N_WEBHOOK_MANUAL_ENROLMENT=
N8N_WEBHOOK_UPDATE_CLAIM_ID_ALL_COURSE_RUN=
N8N_WEBHOOK_CHECK_DUPLICATES_DA=
N8N_WEBHOOK_DIRECT_APPLICATION_ENROLMENT=
N8N_WEBHOOK_GRANT_QUERY=
N8N_WEBHOOK_PROCESS_ENROLMENT_GRANTS=
N8N_WEBHOOK_COMPANY_SPONSORED_ENROLMENT=
N8N_WEBHOOK_APPEND_CANCELLED_CLASS_TRAINEES=

# Optional: override default (10 minutes) for long n8n runs
# N8N_WEBHOOK_TIMEOUT_MS=600000

# Option B — single JSON secret (all keys above as property names, values = full URLs):
# ------------------------------------------------------------------------------------
# N8N_FINANCE_WEBHOOKS_JSON={"N8N_WEBHOOK_APPEND_CANCELLED_CLASS_TRAINEES":"https://your-n8n/webhook/..." , ... }
