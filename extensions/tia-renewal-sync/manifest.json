{
  "manifest_version": 3,
  "name": "TIA TPG Renewal Sync (Local Trial)",
  "version": "0.1.6",
  "description": "Captures complete TPG course applications for a reviewed TIA localhost renewal update.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["https://www.tpgateway.gov.sg/*", "http://localhost:3000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://localhost:3000/*"], "js": ["tia-bridge.js"], "run_at": "document_idle" },
    { "matches": ["https://www.tpgateway.gov.sg/*"], "js": ["tpg-reader.js"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "TIA TPG Renewal Sync trial" }
}
